# Copy to .env.local and fill in. Never commit real tokens.

# Duffel access token for live flight and hotel search (https://duffel.com).
# Use a duffel_test_… token while developing; switch to duffel_live_… to sell real fares.
DUFFEL_ACCESS_TOKEN=

# Optional: point the Duffel SDK at a proxy or a local mock instead of https://api.duffel.com.
# DUFFEL_API_URL=
